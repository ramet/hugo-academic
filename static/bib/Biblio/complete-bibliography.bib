@Misc{c:LaBRI::HOSCAR2012b,
  author = 	 {Lacoste, X. and Faverge, M. and Ramet, P.},
  title = 	 {Scheduling for Sparse Solver on Manycore Architectures},
  howpublished = {Workshop INRIA-CNPq, HOSCAR meeting, Petropolis, Brazil},
  OPTcrossref =  {},
  OPTkey = 	 {},
  OPTpages = 	 {},
