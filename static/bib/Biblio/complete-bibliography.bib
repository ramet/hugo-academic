@InProceedings{C:LaBRI::PMAA2012,
  author =       "Bosilca, G. and Faverge, M. and Lacoste, X. and Yamazaki, I. and Ramet, P.",
  title =        "Toward a supernodal sparse direct solver over {DAG} runtimes",
